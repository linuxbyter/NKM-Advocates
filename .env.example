# Neon PostgreSQL (Drizzle ORM - https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# AI Chat + admin AI drafting (Groq free tier - https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key

# Email notifications — pick ONE transport (optional; enquiries always save to DB)
# Option A: Resend (https://resend.com)
# RESEND_API_KEY=re_your_api_key
# Option B: SMTP (Hostinger: smtp.hostinger.com:465, user = your @domain mailbox)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your_mailbox_password
NOTIFICATION_EMAIL=lawfirmnkmadvocates@gmail.com

# Admin panel (/agnes)
ADMIN_PASSWORD=your_admin_password
ADMIN_SECRET=random_long_secret_string
